apiVersion: yawr.runbook/v1
id: graph-dynamic-router
name: Dynamic router - nested calls and returns
vars:
  selected_runbook: graph-demo/investigate
outputs:
  scenario: {type: string, value: dynamic-router}
flow:
  - step: {id: route_recommendation, type: noop}
  - step:
      id: run_bound_catalog_capability
      type: include
      title: Enter selected catalog runbook
      include:
        runbook_ref: "${selected_runbook}"
        resolve_from: catalog
  - step: {id: router_return, type: noop, title: Returned to the router}
  - step: {id: results, type: results, title: Results}
