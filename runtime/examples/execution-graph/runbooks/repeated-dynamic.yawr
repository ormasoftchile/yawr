apiVersion: yawr.runbook/v1
id: graph-repeated-dynamic
name: Repeated dynamic calls retain both investigations
vars:
  targets: "graph-demo/investigate,graph-demo/investigate"
flow:
  - iterate:
      id: investigations
      over: targets
      as: selected
      steps:
        - step:
            id: invoke
            type: include
            include:
              runbook_ref: "${selected}"
              resolve_from: catalog
  - step: {id: returned, type: noop}
