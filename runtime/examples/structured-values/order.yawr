apiVersion: yawr.runbook/v1
id: order
name: Apply a YAML-authored timestamp ordering rule
inputs:
  observations: {type: array, required: true}
outputs:
  ordering:
    type: object
    value_expr: >-
      list.order(observations,
      'date.diffSeconds(left.min, right.min) < -1800 or
      (date.diffSeconds(left.min, right.min) >= -1800 and
      date.diffSeconds(left.min, right.min) <= 1800 and
      date.compare(left.max, right.max) < 0)')
flow:
  - step: {id: evaluate_ordering, type: noop}
