apiVersion: yawr.runbook/v1
id: structured-values
name: Verify public structured collection and nested export contracts
requires:
  - {package: acme.structured-values, version: "^1.0.0"}
toolRefs:
  - {name: records, package: acme.structured-values}
flow:
  - step:
      id: relay
      type: tool
      tool: {name: records, action: relay}
      capture:
        records: outputs.records
        labels: outputs.labels
  - step:
      id: verify_associations
      type: assert
      assert:
        - {type: eq, subject: '${len(records) == 4 and records[0].configuration.id == "alpha" and records[1].configuration.id == "beta"}', expected: "true"}
        - {type: eq, subject: '${len(records[0].rows) == 2 and len(records[1].rows) == 1 and len(records[2].rows) == 0}', expected: "true"}
        - {type: eq, subject: '${records[0].rows[1].index == 2 and records[0].rows[0].active == true and records[1].rows[0].metadata.weight == 2.5 and records[1].rows[0].metadata.note == null}', expected: "true"}
        - {type: eq, subject: '${records[1].rows[0].tags[1] == "beta" and labels[0] == "alpha" and labels[1] == "beta" and labels[3] == "empty"}', expected: "true"}
        - {type: eq, subject: '${records[0].status == "observed" and records[3].status == "no-data" and records[2].status == "missing" and len(records[2].rows) == 0}', expected: "true"}
