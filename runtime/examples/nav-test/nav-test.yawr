apiVersion: yawr.runbook/v1
id: nav-test
name: nav-test
kind: mitigation
description: >
  Navigation test fixture. Three steps, each echoing a unique string.
  Used to verify post-completion step focus navigation.

flow:
  - step:
      id: step_alpha
      title: Alpha Step
      type: cli
      run: echo "ALPHA_UNIQUE_OUTPUT_XYZ"

  - step:
      id: step_beta
      title: Beta Step
      type: cli
      run: echo "BETA_UNIQUE_OUTPUT_XYZ"

  - step:
      id: step_gamma
      title: Gamma Step
      type: cli
      run: echo "GAMMA_UNIQUE_OUTPUT_XYZ"
