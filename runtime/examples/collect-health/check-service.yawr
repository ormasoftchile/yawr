# Child runbook: DNS lookup + ping check for a single host.
# Called by collect-health.yawr via include.
apiVersion: yawr.runbook/v1

id: check-service
name: check-service
kind: reference
description: DNS lookup and ping check for a single host — both always run

toolRefs:
  - name: nslookup
    path: ../../tools/nslookup.tool.yaml
  - name: ping
    path: ../../tools/ping.tool.yaml

flow:
  - step:
      id: dns_lookup
      type: tool
      title: "DNS lookup ${service_host}"
      on_error: continue
      tool:
        name: nslookup
        action: lookup
        args:
          name: "${service_host}"
      capture:
        dns_out: stdout
        dns_exit: exit_code

  - step:
      id: ping_host
      type: tool
      title: "Ping ${service_host}"
      on_error: continue
      tool:
        name: ping
        action: check
        args:
          host: "${service_host}"
          count: "3"
      capture:
        ping_out: stdout
        ping_exit: exit_code

  - step:
      id: summarize
      type: noop
      title: "Summarize ${service_host}"
      capture:
        checked_host: "${service_host}"
        host_ok: "${dns_exit == 0 and ping_exit == 0}"
        host_errors: ""
        host_summary: "DNS=${dns_exit} Ping=${ping_exit}"
