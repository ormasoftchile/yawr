apiVersion: yawr.runbook/v1

id: service-health-branching
name: service-health-branching
kind: mitigation
description: DNS + HTTP health check with conditional branching

toolRefs:
  - name: nslookup
    path: ../../tools/nslookup.tool.yaml
  - name: curl
    path: ../../tools/curl.tool.yaml
  - name: ping
    path: ../../tools/ping.tool.yaml

vars:
  hostname: github.com

inputs:
  server_name:
    type: string
    required: false
    description: Server to check
    from: prompt

flow:
  - step:
      id: resolve_dns
      type: tool
      title: Resolve DNS for hostname
      tool:
        name: nslookup
        action: lookup
        args:
          name: "${hostname}"
      capture:
        dns_output: stdout

  - step:
      id: branch_dns
      type: branch
      branches:
        - condition: 'str.contains(dns_output, "Address")'
          label: DNS resolved
          steps:
            - step:
                id: check_http
                type: tool
                title: Check HTTP endpoint
                tool:
                  name: curl
                  action: head
                  args:
                    url: "https://${hostname}"
                capture:
                  http_response: stdout

            - step:
                id: branch_http
                type: branch
                branches:
                  - condition: 'str.contains(http_response, "200")'
                    label: HTTP OK
                    steps:
                      - step:
                          id: confirm_healthy
                          type: end
                          title: Service is healthy
                          outcome:
                            category: resolved
                            code: healthy

                  - condition: 'not str.contains(http_response, "200")'
                    label: HTTP failed
                    steps:
                      - step:
                          id: escalate_http
                          type: collector
                          title: HTTP endpoint not responding
                          prompt: |
                            HTTP check failed for ${hostname}.
                            Response: ${http_response}
                            Check load balancer and backend pods.
                          fields:
                            - name: notes
                              type: text
                              label: Investigation notes
                              required: false
                              multiline: true

                      - step:
                          id: end_escalated
                          type: end
                          title: Escalated — HTTP failure
                          outcome:
                            category: escalated
                            code: http_failure

        - condition: 'not str.contains(dns_output, "Address")'
          label: DNS failed
          steps:
            - step:
                id: check_dns_propagation
                type: tool
                title: Ping fallback IP
                tool:
                  name: ping
                  action: check
                  args:
                    host: "140.82.121.3"
                    count: "2"
                capture:
                  ping_result: stdout

            - step:
                id: escalate_dns
                type: collector
                title: DNS resolution failed
                prompt: |
                  DNS did not resolve for ${hostname}.
                  Ping fallback result: ${ping_result}
                  Check DNS zone records and TTL.
                fields:
                  - name: dns_investigation
                    type: text
                    label: DNS investigation notes
                    required: true
                    multiline: true
                required_evidence:
                  - kind: text
                    name: dns_investigation

            - step:
                id: end_dns_fail
                type: end
                title: Escalated — DNS failure
                outcome:
                  category: escalated
                  code: dns_failure
