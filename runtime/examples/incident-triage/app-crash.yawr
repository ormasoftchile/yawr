# Incident Triage — Application Crash Investigation (Child)
# Invoked by incident-triage.yawr for application-category incidents.
#
# Demonstrates: child include target, branching by crash type, choice steps,
# approval gates, evidence collection.
apiVersion: yawr.runbook/v1

id: incident-triage.app-crash
name: incident-triage.app-crash
kind: mitigation
description: >
  Investigate application crashes including OOM kills, unhandled exceptions,
  and process exits. Checks service health and guides through log analysis.

toolRefs:
  - name: curl
    path: ../../tools/curl.tool.yaml

inputs:
  service_name:
    type: string
    required: false
    description: Affected service name
    from: prompt
  incident_id:
    type: string
    required: false
    description: Incident tracking ID
    from: prompt

flow:
  - step:
      id: check_service_status
      type: tool
      title: Check service health endpoint
      tool:
        name: curl
        action: head
        args:
          url: "https://${service_name}/healthz"
      capture:
        health_status: stdout

  - step:
      id: classify_crash
      type: choice
      title: Classify the crash type
      prompt: |
        Service health response: ${health_status}

        Review application logs and monitoring for ${service_name}.
        Determine the crash type:
      variable: crash_type
      options:
        - value: "oom"
          label: "Out of memory — OOM kill observed"
        - value: "exception"
          label: "Unhandled exception — stack trace in logs"
        - value: "dependency"
          label: "Dependency failure — downstream service unavailable"
        - value: "config"
          label: "Configuration error — recent config change"

  - step:
      id: branch_crash_type
      type: branch
      branches:
        - condition: 'crash_type == "oom"'
          label: OOM investigation
          steps:
            - step:
                id: oom_investigate
                type: collector
                title: Investigate memory exhaustion
                prompt: |
                  For ${service_name}:
                  1. Check memory usage trend (last 24h)
                  2. Look for memory leak patterns
                  3. Check if recent deployment changed memory limits
                  4. Review heap dump if available
                fields:
                  - name: oom_analysis
                    type: text
                    label: OOM analysis notes
                    required: true
                    multiline: true
                required_evidence:
                  - kind: text
                    name: oom_analysis

            - step:
                id: oom_mitigate
                type: collector
                title: Apply OOM mitigation
                prompt: |
                  Options:
                  - Restart affected instances
                  - Increase memory limits temporarily
                  - Roll back recent deployment if it introduced the leak
                fields:
                  - name: mitigation_action
                    type: text
                    label: Mitigation action taken
                    required: false
                    multiline: true

            - step:
                id: oom_done
                type: end
                title: OOM investigation complete
                outcome:
                  category: resolved
                  code: oom_mitigated

        - condition: 'crash_type == "exception"'
          label: Exception investigation
          steps:
            - step:
                id: exception_check
                type: collector
                title: Analyze exception stack trace
                prompt: |
                  Pull the stack trace from application logs for ${service_name}.
                  Determine:
                  1. Is this a known bug?
                  2. Was it introduced by a recent deployment?
                  3. Can it be fixed by rollback?
                fields:
                  - name: stack_trace
                    type: text
                    label: Stack trace
                    required: true
                    multiline: true
                required_evidence:
                  - kind: text
                    name: stack_trace

            - step:
                id: exception_done
                type: end
                title: Exception analysis complete
                outcome:
                  category: escalated
                  code: exception_review

        - condition: 'crash_type == "dependency"'
          label: Dependency failure
          steps:
            - step:
                id: dep_check
                type: collector
                title: Check downstream dependencies
                prompt: |
                  Verify status of all downstream dependencies for ${service_name}.
                  Check:
                  1. Dependency health endpoints
                  2. Circuit breaker status
                  3. Timeout configuration
                fields:
                  - name: dependency_notes
                    type: text
                    label: Dependency investigation notes
                    required: false
                    multiline: true

            - step:
                id: dep_done
                type: end
                title: Dependency failure identified
                outcome:
                  category: escalated
                  code: dependency_failure

        - condition: 'crash_type == "config"'
          label: Configuration error
          steps:
            - step:
                id: config_check
                type: collector
                title: Review recent configuration changes
                prompt: |
                  Check configuration management for ${service_name}:
                  1. Recent config deployments
                  2. Environment variable changes
                  3. Feature flag changes
                  4. Secret rotation events
                fields:
                  - name: config_notes
                    type: text
                    label: Configuration investigation notes
                    required: false
                    multiline: true

            - step:
                id: config_rollback
                type: collector
                title: Roll back configuration if applicable
                prompt: |
                  If a recent config change is identified as the cause:
                  1. Roll back to last known good configuration
                  2. Restart affected instances
                  3. Verify service recovers
                fields:
                  - name: rollback_notes
                    type: text
                    label: Rollback notes
                    required: false
                    multiline: true

            - step:
                id: config_approve
                type: approve
                title: Approve configuration rollback
                approvals:
                  min: 1
                  roles: ["dri"]

            - step:
                id: config_done
                type: end
                title: Configuration issue resolved
                outcome:
                  category: resolved
                  code: config_rollback
