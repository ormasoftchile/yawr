apiVersion: yawr.runbook/v1
id: code-presentation
name: Offline code presentation
toolRefs:
  - name: code
    path: code.yawt
flow:
  - step:
      id: sql
      type: tool
      tool:
        name: code
        action: sql
        args:
          text: |-
            SELECT name
            FROM synthetic_table
            WHERE enabled = 1;
  - step:
      id: kql
      type: tool
      tool:
        name: code
        action: kql
        args:
          text: |-
            print message = "No provider is called"
            | project message
  - step:
      id: powershell
      type: tool
      tool:
        name: code
        action: powershell
        args:
          text: 'Write-Output "Stored as data, never executed"'
