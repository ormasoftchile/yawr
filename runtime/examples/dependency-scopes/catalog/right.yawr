apiVersion: yawr.runbook/v1
id: lexical-right
name: Right child owns its query binding
requires:
  - {package: scope.right, version: "^1.0.0", path: tools/right}
toolRefs:
  - {name: query, package: scope.right}
flow:
  - step:
      id: query
      type: tool
      tool: {name: query, action: read}
      capture: {observed: outputs.marker}
  - step:
      id: verify_right
      type: assert
      assert: [{type: eq, subject: "${observed}", expected: right}]
