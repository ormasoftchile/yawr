apiVersion: yawr.runbook/v1
id: lexical-static-lazy
name: File-local query bindings across eager and lazy children
outputs:
  scenario: {type: string, value: lexical-static-lazy}
requires:
  - {package: scope.left, version: "^1.0.0", path: catalog/tools/left}
toolRefs:
  - {name: query, package: scope.left}
flow:
  - step:
      id: parent_before
      type: tool
      tool: {name: query, action: read}
      capture: {before_marker: outputs.marker}
  - step:
      id: eager_right
      type: include
      include: {runbook: catalog/right.yawr, expand: eager}
  - step:
      id: lazy_left
      type: include
      include: {runbook: catalog/left.yawr, expand: lazy}
  - step:
      id: parent_after
      type: tool
      tool: {name: query, action: read}
      capture: {after_marker: outputs.marker}
  - step:
      id: parent_binding_preserved
      type: assert
      assert:
        - {type: eq, subject: "${before_marker}", expected: left}
        - {type: eq, subject: "${after_marker}", expected: left}
  - step: {id: results, type: results, title: Results}
