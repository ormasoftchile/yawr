apiVersion: yawr.runbook/v1
id: lexical-dynamic-parallel
name: Parallel dynamic children retain their own tool scopes
outputs:
  scenario: {type: string, value: lexical-dynamic-parallel}
requires:
  - {package: scope-children, version: "^1.0.0", path: catalog}
flow:
  - parallel:
      id: investigate
      branches:
        - label: left
          steps:
            - step:
                id: enter_left
                type: include
                include: {runbook_ref: scope-children/left, resolve_from: catalog}
        - label: right
          steps:
            - step:
                id: enter_right
                type: include
                include: {runbook_ref: scope-children/right, resolve_from: catalog}
  - step: {id: both_children_returned, type: noop}
  - step: {id: results, type: results, title: Results}
