# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union
.squad/rai/audit-trail.md merge=union
.squad/fact-checker/audit-trail.md merge=union

* text=auto
*.go text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.yawr text eol=lf linguist-language=YAML
*.yawt text eol=lf linguist-language=YAML
*.ps1 text eol=crlf
*.exe binary
*.png binary
*.svg text eol=lf
